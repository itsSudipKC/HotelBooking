# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local: mongodb://localhost:27017/hotelbooking
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotelbooking
MONGO_URI=mongodb://localhost:27017/hotelbooking

# ── JWT ───────────────────────────────────────────────────
# Use long random strings in real environments, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRY=7d

# ── Client ────────────────────────────────────────────────
# Used for CORS and for building links inside emails (verify/reset URLs)
CLIENT_URL=http://localhost:5173

# ── Admin seed (used only by `npm run seed:admin`) ───────
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ── Email (Nodemailer SMTP) ───────────────────────────────
# Gmail: smtp.gmail.com / 587, and an "App Password" (not your normal password)
# For local testing without a real inbox, use Ethereal: https://ethereal.email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Hotel Booking System <no-reply@hotelbooking.com>"

# ── Cloudinary (image storage — used starting the Hotel/Room module) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments (used starting the Payment module) ───────────
# eSewa sandbox docs: https://developer.esewa.com.np
ESEWA_MERCHANT_CODE=
ESEWA_SECRET=
# Khalti sandbox docs: https://docs.khalti.com
KHALTI_SECRET_KEY=

# ── Google Maps (used starting the Hotel/Room module) ─────
GOOGLE_MAPS_API_KEY=
