# Only needed in production, or in dev if you don't want to use the Vite
# proxy in vite.config.js. Leave unset in local dev — requests to /api are
# proxied to http://localhost:5000 automatically.
VITE_API_URL=http://localhost:5000/api

# Optional. Powers the embedded map on the hotel details page. Without it,
# the map falls back to a static placeholder showing the hotel's address.
VITE_GOOGLE_MAPS_API_KEY=
